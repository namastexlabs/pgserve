{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.js",
    "bin/postgres-server.js",
    "bin/pgserve-wrapper.cjs",
    "src/upgrade/index.js",
    "console/src/main.jsx"
  ],
  "project": [
    "src/**/*.js",
    "bin/**/*.js",
    "bin/**/*.cjs",
    "console/src/**/*.{js,jsx}"
  ],
  "ignore": [
    "tests/**",
    "helpers/**",
    "scripts/**"
  ],
  "ignoreBinaries": [
    "scripts/test-npx.sh",
    "scripts/test-bun-self-heal.sh",
    "make"
  ],
  "ignoreDependencies": [
    "bun",
    "react",
    "react-dom",
    "pg"
  ],
  "ignoreExportsUsedInFile": true
}
